generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Access {
  NONE
  VIEW
  EDIT
}

// CRM
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  CONVERTED
  LOST
  UNQUALIFIED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  LEAD
  POTENTIAL
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  ACTIVE
  COMPLETED
  TERMINATED
}

enum BillingType {
  FIXED
  HOURLY
  RETAINER
}

enum FollowUpType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
}

enum FollowUpStatus {
  PENDING
  DONE
}

enum TagType {
  LEAD_SOURCE
  LEAD_STATUS
  DEAL_STAGE
  PROJECT_TYPE
  PROJECT_STATUS
  GENERAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// Projects
enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum ProjectMemberRole {
  PROJECT_MANAGER
  TEAM_MEMBER
  REVIEWER
  VIEWER
}

// Team
enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

// Finance
enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  CHEQUE
}

enum ExpensePaidBy {
  COMPANY
  EMPLOYEE
}

// ─────────────────────────── Settings / Auth ───────────────────────────

model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  passwordHash      String
  name              String
  roleId            String
  role              Role                   @relation(fields: [roleId], references: [id])
  employeeId        String?                @unique
  employee          Employee?              @relation(fields: [employeeId], references: [id])
  active            Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  comments          Comment[]              @relation("CommentAuthor")
  activityLogs      ActivityLog[]
  notificationPrefs UserNotificationPref[]
  leads             Lead[]
  ownedCompanies    Company[]
  ownedContacts     Contact[]
  ownedDeals        Deal[]
  ownedFollowUps    FollowUp[]
  timeEntriesLogged TimeEntry[]
  createdAttendance Attendance[]
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  isDefault   Boolean  @default(false)
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  headId    String?
  head      Employee?  @relation("DepartmentHead", fields: [headId], references: [id])
  color     String     @default("#3b82f6")
  createdAt DateTime   @default(now())
  employees Employee[] @relation("EmployeeDepartment")
}

model Technology {
  id        String          @id @default(cuid())
  name      String          @unique
  category  String?
  color     String          @default("#3b82f6")
  createdAt DateTime        @default(now())
  skills    EmployeeSkill[]
  tags      ProjectTag[]    @relation("ProjectTechnologyTags")
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  type      TagType      @default(GENERAL)
  color     String       @default("#6b7280")
  createdAt DateTime     @default(now())
  companies CompanyTag[]
  projects  ProjectTag[]
}

model CompanySettings {
  id                      Int      @id @default(1)
  companyName             String   @default("")
  logoUrl                 String?
  address                 String?
  phone                   String?
  email                   String?
  vatNumber               String?
  currency                String   @default("AED")
  vatRate                 Decimal  @default(0) @db.Decimal(6, 2)
  defaultPaymentTermsDays Int      @default(30)
  invoiceNumberPrefix     String   @default("INV-")
  invoiceNextNumber       Int      @default(1)
  proposalNumberPrefix    String   @default("QUO-")
  proposalNextNumber      Int      @default(1)
  contractNumberPrefix    String   @default("CTR-")
  contractNextNumber      Int      @default(1)
  defaultWeeklyHours      Int      @default(40)
  updatedAt               DateTime @updatedAt
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model NotificationSetting {
  id        String   @id @default(cuid())
  type      String   @unique
  enabled   Boolean  @default(true)
  channels  Json     @default("[]")
  createdAt DateTime @default(now())
}

model UserNotificationPref {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, type])
}

// ─────────────────────────── CRM ───────────────────────────

model Lead {
  id            String     @id @default(cuid())
  name          String
  email         String?
  phone         String?
  source        String?
  companyName   String?
  expectedValue Decimal?   @db.Decimal(12, 2)
  status        LeadStatus @default(NEW)
  ownerId       String?
  owner         User?      @relation(fields: [ownerId], references: [id])
  notes         String?
  archived      Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Company {
  id           String        @id @default(cuid())
  name         String
  industry     String?
  size         String?
  website      String?
  phone        String?
  email        String?
  address      String?
  vatId        String?
  status       CompanyStatus @default(ACTIVE)
  ownerId      String?
  owner        User?         @relation(fields: [ownerId], references: [id])
  notes        String?
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  contacts     Contact[]
  deals        Deal[]
  proposals    Proposal[]
  contracts    Contract[]
  projects     Project[]
  meetingNotes MeetingNote[]
  followUps    FollowUp[]
  invoices     Invoice[]
  expenses     Expense[]
  tags         CompanyTag[]
}

model Contact {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id])
  name             String
  email            String?
  phone            String?
  position         String?
  department       String?
  isPrimary        Boolean           @default(false)
  ownerId          String?
  owner            User?             @relation(fields: [ownerId], references: [id])
  notes            String?
  archived         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deals            Deal[]
  meetingAttendees MeetingAttendee[]
  followUps        FollowUp[]
  proposals        Proposal[]
}

model Deal {
  id                String        @id @default(cuid())
  name              String
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id])
  contactId         String?
  contact           Contact?      @relation(fields: [contactId], references: [id])
  value             Decimal?      @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  probability       Int           @default(50)
  stage             DealStage     @default(LEAD)
  ownerId           String?
  owner             User?         @relation(fields: [ownerId], references: [id])
  notes             String?
  archived          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  proposals         Proposal[]
  followUps         FollowUp[]
  meetingNotes      MeetingNote[]
}

model ProposalItem {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id])
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}

model Proposal {
  id             String         @id @default(cuid())
  number         String         @unique
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  contactId      String?
  contact        Contact?       @relation(fields: [contactId], references: [id])
  dealId         String?
  deal           Deal?          @relation(fields: [dealId], references: [id])
  status         ProposalStatus @default(DRAFT)
  issueDate      DateTime       @default(now())
  validUntil     DateTime?
  total          Decimal        @default(0) @db.Decimal(12, 2)
  terms          String?
  recipientEmail String?
  pdfUrl         String?
  archived       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  items          ProposalItem[]
  contracts      Contract[]
}

model Contract {
  id           String         @id @default(cuid())
  number       String         @unique
  proposalId   String?
  proposal     Proposal?      @relation(fields: [proposalId], references: [id])
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  startDate    DateTime
  endDate      DateTime?
  value        Decimal        @db.Decimal(12, 2)
  status       ContractStatus @default(DRAFT)
  billingType  BillingType    @default(FIXED)
  signedPdfUrl String?
  terms        String?
  notes        String?
  archived     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  projects     Project[]
  invoices     Invoice[]
}

model FollowUp {
  id        String         @id @default(cuid())
  companyId String?
  company   Company?       @relation(fields: [companyId], references: [id])
  contactId String?
  contact   Contact?       @relation(fields: [contactId], references: [id])
  dealId    String?
  deal      Deal?          @relation(fields: [dealId], references: [id])
  dueDate   DateTime
  type      FollowUpType   @default(CALL)
  notes     String?
  status    FollowUpStatus @default(PENDING)
  ownerId   String?
  owner     User?          @relation(fields: [ownerId], references: [id])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model MeetingNote {
  id        String            @id @default(cuid())
  title     String
  date      DateTime          @default(now())
  companyId String?
  company   Company?          @relation(fields: [companyId], references: [id])
  dealId    String?
  deal      Deal?             @relation(fields: [dealId], references: [id])
  notes     String?
  summary   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  attendees MeetingAttendee[]
}

model MeetingAttendee {
  meetingNoteId String
  meetingNote   MeetingNote @relation(fields: [meetingNoteId], references: [id])
  contactId     String
  contact       Contact     @relation(fields: [contactId], references: [id])

  @@id([meetingNoteId, contactId])
}

model CompanyTag {
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([companyId, tagId])
}

// ─────────────────────────── Projects ───────────────────────────

model ProjectTemplate {
  id          String                     @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime                   @default(now())
  milestones  ProjectTemplateMilestone[]
  tasks       ProjectTemplateTask[]
}

model ProjectTemplateMilestone {
  id         String                @id @default(cuid())
  templateId String
  template   ProjectTemplate       @relation(fields: [templateId], references: [id])
  name       String
  order      Int                   @default(0)
  tasks      ProjectTemplateTask[]
}

model ProjectTemplateTask {
  id          String                    @id @default(cuid())
  templateId  String
  template    ProjectTemplate           @relation(fields: [templateId], references: [id])
  milestoneId String?
  milestone   ProjectTemplateMilestone? @relation(fields: [milestoneId], references: [id])
  name        String
  order       Int                       @default(0)
}

model Project {
  id          String          @id @default(cuid())
  name        String
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  contractId  String?
  contract    Contract?       @relation(fields: [contractId], references: [id])
  startDate   DateTime?
  endDate     DateTime?
  status      ProjectStatus   @default(PLANNED)
  budget      Decimal?        @db.Decimal(12, 2)
  description String?
  priority    Priority        @default(MEDIUM)
  archived    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  milestones  Milestone[]
  tasks       Task[]
  sprints     Sprint[]
  members     ProjectMember[]
  comments    Comment[]
  attachments Attachment[]
  timeEntries TimeEntry[]
  invoices    Invoice[]
  expenses    Expense[]
  tags        ProjectTag[]
}

model Milestone {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id])
  name         String
  dueDate      DateTime?
  status       MilestoneStatus @default(PENDING)
  description  String?
  billingValue Decimal?        @db.Decimal(12, 2)
  order        Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tasks        Task[]
  invoices     Invoice[]
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id])
  name      String
  startDate DateTime?
  endDate   DateTime?
  goal      String?
  status    SprintStatus @default(PLANNED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tasks     Task[]
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  milestoneId String?
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id])
  sprintId    String?
  sprint      Sprint?      @relation(fields: [sprintId], references: [id])
  name        String
  description String?
  assigneeId  String?
  assignee    Employee?    @relation(fields: [assigneeId], references: [id])
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?
  priority    Priority     @default(MEDIUM)
  estimate    Decimal?     @db.Decimal(6, 2)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  subtasks    Subtask[]
  comments    Comment[]
  attachments Attachment[]
  timeEntries TimeEntry[]
}

model Subtask {
  id         String    @id @default(cuid())
  taskId     String
  task       Task      @relation(fields: [taskId], references: [id])
  name       String
  done       Boolean   @default(false)
  dueDate    DateTime?
  assigneeId String?
  assignee   Employee? @relation(fields: [assigneeId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ProjectMember {
  id         String            @id @default(cuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id])
  employeeId String
  employee   Employee          @relation(fields: [employeeId], references: [id])
  role       ProjectMemberRole @default(TEAM_MEMBER)
  createdAt  DateTime          @default(now())

  @@unique([projectId, employeeId])
}

model Comment {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  authorId  String
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id           String    @id @default(cuid())
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  taskId       String?
  task         Task?     @relation(fields: [taskId], references: [id])
  name         String
  url          String
  size         Int?
  mimeType     String?
  folder       String?
  versionGroup String?
  uploadedById String?
  uploadedBy   Employee? @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
}

model ProjectTag {
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id])
  tagId        String
  tag          Tag         @relation(fields: [tagId], references: [id])
  technologyId String?
  technology   Technology? @relation("ProjectTechnologyTags", fields: [technologyId], references: [id])

  @@id([projectId, tagId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String?
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ─────────────────────────── Team ───────────────────────────

model Employee {
  id             String          @id @default(cuid())
  userId         String?         @unique
  user           User?
  name           String
  email          String          @unique
  phone          String?
  position       String?
  departmentId   String?
  department     Department?     @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  hireDate       DateTime?
  hourlyRate     Decimal?        @db.Decimal(12, 2)
  status         EmployeeStatus  @default(ACTIVE)
  avatarUrl      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  skills         EmployeeSkill[]
  projectMembers ProjectMember[]
  assignedTasks  Task[]
  subtasks       Subtask[]
  timeEntries    TimeEntry[]
  attendance     Attendance[]
  attachments    Attachment[]
  headOf         Department[]    @relation("DepartmentHead")
}

model EmployeeSkill {
  id           String     @id @default(cuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  technologyId String
  technology   Technology @relation(fields: [technologyId], references: [id])
  level        SkillLevel @default(INTERMEDIATE)

  @@unique([employeeId, technologyId])
}

model TimeEntry {
  id         String   @id @default(cuid())
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id])
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime @default(now())
  hours      Decimal  @db.Decimal(6, 2)
  notes      String?
  billable   Boolean  @default(true)
  loggedById String?
  loggedBy   User?    @relation(fields: [loggedById], references: [id])
  createdAt  DateTime @default(now())
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  date        DateTime  @default(now())
  checkInAt   DateTime?
  checkOutAt  DateTime?
  hours       Decimal?  @db.Decimal(6, 2)
  notes       String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])

  @@unique([employeeId, date])
}

// ─────────────────────────── Finance ───────────────────────────

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  contractId  String?
  contract    Contract?     @relation(fields: [contractId], references: [id])
  milestoneId String?
  milestone   Milestone?    @relation(fields: [milestoneId], references: [id])
  issueDate   DateTime      @default(now())
  dueDate     DateTime
  status      InvoiceStatus @default(DRAFT)
  subtotal    Decimal       @default(0) @db.Decimal(12, 2)
  taxRate     Decimal       @default(0) @db.Decimal(6, 2)
  taxAmount   Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @default(0) @db.Decimal(12, 2)
  terms       String?
  notes       String?
  pdfUrl      String?
  archived    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       InvoiceItem[]
  payments    Payment[]
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(12, 2)
  date      DateTime      @default(now())
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  notes     String?
  createdAt DateTime      @default(now())
}

model Expense {
  id           String          @id @default(cuid())
  description  String
  categoryId   String
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount       Decimal         @db.Decimal(12, 2)
  date         DateTime        @default(now())
  paidBy       ExpensePaidBy   @default(COMPANY)
  reimbursable Boolean         @default(false)
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id])
  companyId    String?
  company      Company?        @relation(fields: [companyId], references: [id])
  receiptUrl   String?
  createdAt    DateTime        @default(now())
}
